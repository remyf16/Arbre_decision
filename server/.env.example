# This is an example environment file.
# Copy this file to .env in the same directory and replace the values with your own.

# A secure, randomly generated string used to sign JSON Web Tokens.
# You can generate a new one here: https://acte.ltd/utils/random-string
JWT_SECRET=your_super_secret_jwt_key_here

# A comma-separated list of allowed origins for CORS requests.
# For production, this should be the URL of your frontend application.
# Example: CORS_ORIGIN=https://your-frontend-app.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# The connection string for your MongoDB database.
MONGO_URI=mongodb://localhost:27017/decision_tree_app
